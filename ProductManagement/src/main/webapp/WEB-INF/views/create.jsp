<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Thêm sản phẩm</title><style>body{font-family:Arial;max-width:600px;margin:40px auto}input,textarea{width:100%;padding:10px;margin:7px 0 15px;box-sizing:border-box}button,a{padding:10px 15px;background:#2563eb;color:white;border:0;text-decoration:none}</style></head><body><h1>Thêm sản phẩm</h1><form method="post" action="products"><input type="hidden" name="action" value="create"><label>Tên sản phẩm</label><input name="name" required><label>Giá</label><input name="price" type="number" step="0.01" required><label>Mô tả</label><textarea name="description" required></textarea><label>Nhà sản xuất</label><input name="manufacturer" required><button>Lưu</button> <a href="products">Quay lại</a></form></body></html>
