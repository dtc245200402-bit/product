<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Quản lý sản phẩm</title><style>body{font-family:Arial;max-width:1100px;margin:40px auto;background:#f5f7fb}h1{color:#222}.top{display:flex;justify-content:space-between;gap:10px;margin-bottom:20px}input,button,a{padding:10px;border-radius:6px;border:1px solid #ccc}button,.btn{background:#2563eb;color:white;border:0;text-decoration:none}.danger{background:#dc2626}.table{width:100%;background:white;border-collapse:collapse}.table th,.table td{padding:13px;border-bottom:1px solid #ddd;text-align:left}.actions a{margin-right:5px}</style></head><body><h1>Quản lý sản phẩm</h1><div class="top"><form action="products" method="get"><input type="hidden" name="action" value="search"><input name="name" placeholder="Tìm theo tên sản phẩm"><button>Tìm kiếm</button></form><a class="btn" href="products?action=create">+ Thêm sản phẩm</a></div><table class="table"><tr><th>ID</th><th>Tên sản phẩm</th><th>Giá</th><th>Mô tả</th><th>Nhà sản xuất</th><th>Thao tác</th></tr><c:forEach var="p" items="${products}"><tr><td>${p.id}</td><td>${p.name}</td><td>${p.price}</td><td>${p.description}</td><td>${p.manufacturer}</td><td class="actions"><a href="products?action=view&id=${p.id}">Xem</a><a href="products?action=edit&id=${p.id}">Sửa</a><a class="btn danger" href="products?action=delete&id=${p.id}" onclick="return confirm('Bạn có chắc muốn xoá?')">Xoá</a></td></tr></c:forEach></table></body></html>
