<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Chi tiết sản phẩm</title><style>body{font-family:Arial;max-width:700px;margin:40px auto}.card{background:#f5f7fb;padding:25px;border-radius:10px}a{display:inline-block;margin-top:15px;padding:10px;background:#2563eb;color:white;text-decoration:none;border-radius:6px}</style></head><body><h1>Chi tiết sản phẩm</h1><div class="card"><p><b>ID:</b> ${product.id}</p><p><b>Tên:</b> ${product.name}</p><p><b>Giá:</b> ${product.price}</p><p><b>Mô tả:</b> ${product.description}</p><p><b>Nhà sản xuất:</b> ${product.manufacturer}</p></div><a href="products">Quay lại danh sách</a></body></html>
